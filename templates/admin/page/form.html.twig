{% set form = hookable_metadata.context.form %}
{% import '@SyliusAdmin/shared/helper/translations.html.twig' as translations %}

<div class="row">
    <div class="col-12 col-md-8">
        <div class="card mb-3">
            <div class="card-header"><div class="card-title">{{ 'akawaka_cms.ui.content'|trans }}</div></div>
            {{ translations.default(form.translations, null, { accordion_flush: true }) }}
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card mb-3">
            <div class="card-header"><div class="card-title">{{ 'akawaka_cms.ui.publication'|trans }}</div></div>
            <div class="card-body">
                {{ form_row(form.code) }}
                {{ form_row(form.channels) }}
            </div>
        </div>
    </div>
</div>
{{ form_rest(form) }}
