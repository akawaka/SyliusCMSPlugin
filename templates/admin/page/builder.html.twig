{# Page builder for one locale. Expects `translation_form` (PageTranslationType view). #}
{% set catalog = [] %}
{% for entry in cms_block_catalog() %}
    {% set catalog = catalog|merge([entry|merge({icon: ux_icon(entry.icon) ~ ''})]) %}
{% endfor %}

{% set preview_labels = {
    title: 'akawaka_cms.preview.title'|trans,
    preview: 'akawaka_cms.preview.toggle'|trans,
    edit: 'akawaka_cms.preview.edit'|trans,
    loading: 'akawaka_cms.preview.loading'|trans,
    error: 'akawaka_cms.preview.error'|trans,
    invalid: 'akawaka_cms.preview.invalid'|trans,
    warnings: 'akawaka_cms.preview.warnings'|trans,
} %}

{% set labels = {
    empty_canvas: 'akawaka_cms.builder.empty_canvas'|trans,
    empty_container: 'akawaka_cms.builder.empty_container'|trans,
    select_hint: 'akawaka_cms.builder.select_hint'|trans,
    no_props: 'akawaka_cms.builder.no_props'|trans,
    load_error: 'akawaka_cms.builder.load_error'|trans,
    invalid_json: 'akawaka_cms.builder.invalid_json'|trans,
    confirm_remove: 'akawaka_cms.builder.confirm_remove'|trans,
    duplicate: 'akawaka_cms.builder.duplicate'|trans,
    remove: 'akawaka_cms.builder.remove'|trans,
    move: 'akawaka_cms.builder.move'|trans,
    copy_empty: 'akawaka_cms.builder.copy_empty'|trans,
    copy_confirm: 'akawaka_cms.builder.copy_confirm'|trans,
    fullscreen: 'akawaka_cms.builder.fullscreen'|trans,
    widen: 'akawaka_cms.builder.widen'|trans,
    narrow: 'akawaka_cms.builder.narrow'|trans,
    exit_fullscreen: 'akawaka_cms.builder.exit_fullscreen'|trans,
} %}

<div class="akb-wrap"
     data-controller="akawaka-cms-preview"
     data-action="akawaka-cms-builder:change->akawaka-cms-preview#schedule"
     data-akawaka-cms-preview-url-value="{{ path('akawaka_cms_admin_page_preview') }}"
     data-akawaka-cms-preview-csrf-value="{{ csrf_token('akawaka_cms_preview') }}"
     data-akawaka-cms-preview-locale-value="{{ locale }}"
     data-akawaka-cms-preview-field-prefix-value="{{ translation_form.vars.full_name }}"
     data-akawaka-cms-preview-devices-value="{{ {mobile: 375, tablet: 768, desktop: 1280}|json_encode }}"
     data-akawaka-cms-preview-labels-value="{{ preview_labels|json_encode }}">
<div class="akb"
     data-controller="akawaka-cms-builder"
     data-akawaka-cms-builder-catalog-value="{{ catalog|json_encode }}"
     data-akawaka-cms-builder-form-url-value="{{ path('akawaka_cms_admin_block_form', {type: '__type__'}) }}"
     data-akawaka-cms-builder-labels-value="{{ labels|json_encode }}"
     data-locale="{{ locale }}">
    <div class="akb__toolbar">
        <button type="button" class="btn btn-sm" data-akawaka-cms-builder-target="undo" data-action="akawaka-cms-builder#undo" title="{{ 'akawaka_cms.builder.undo'|trans }}">{{ ux_icon('tabler:arrow-back-up') }}</button>
        <button type="button" class="btn btn-sm" data-akawaka-cms-builder-target="redo" data-action="akawaka-cms-builder#redo" title="{{ 'akawaka_cms.builder.redo'|trans }}">{{ ux_icon('tabler:arrow-forward-up') }}</button>
        <button type="button" class="btn btn-sm ms-auto" data-akawaka-cms-preview-target="toggle" data-action="akawaka-cms-preview#toggle">{{ ux_icon('tabler:device-desktop-analytics') }} <span data-akawaka-cms-preview-target="toggleLabel">{{ 'akawaka_cms.preview.toggle'|trans }}</span></button>
        <button type="button" class="btn btn-sm akb-fullscreen-toggle" aria-pressed="false" data-akawaka-cms-builder-target="fullscreen" data-action="akawaka-cms-builder#toggleFullscreen" title="{{ 'akawaka_cms.builder.fullscreen'|trans }}">
            <span class="akb-fullscreen-toggle__enter">{{ ux_icon('tabler:arrows-maximize') }}</span>
            <span class="akb-fullscreen-toggle__exit">{{ ux_icon('tabler:arrows-minimize') }}</span>
        </button>
    </div>

    <div class="akb__error" hidden data-akawaka-cms-builder-target="error"></div>

    <div class="akb__body">
        <div class="akb__pane akb__pane--palette">
            <h4 class="akb-pane-title">{{ 'akawaka_cms.builder.blocks'|trans }}</h4>
            <div class="akb-palette" data-akawaka-cms-builder-target="palette"></div>
            {% if locales|length > 1 %}
                <div class="akb-copy">
                    <h4 class="akb-pane-title">{{ 'akawaka_cms.builder.copy_title'|trans }}</h4>
                    <select class="form-select form-select-sm" data-akawaka-cms-builder-target="copySelect"
                            data-action="focus->akawaka-cms-builder#refreshCopyOptions pointerdown->akawaka-cms-builder#refreshCopyOptions change->akawaka-cms-builder#copyFromLocale"
                            aria-label="{{ 'akawaka_cms.builder.copy_title'|trans }}">
                        <option value="">{{ 'akawaka_cms.builder.copy_from'|trans }}</option>
                        {% for other in locales %}
                            {% if other != locale %}<option value="{{ other }}">{{ other }}</option>{% endif %}
                        {% endfor %}
                    </select>
                </div>
            {% endif %}
        </div>
        <div class="akb__pane akb__canvas" data-akawaka-cms-builder-target="canvas" data-action="click->akawaka-cms-builder#onCanvasClick"></div>
        <div class="akb__pane akb__pane--inspector">
            <div class="akb-inspector__tools">
                <button type="button" class="btn btn-sm akb-widen" aria-pressed="false" data-akawaka-cms-builder-target="widen" data-action="akawaka-cms-builder#toggleWide" title="{{ 'akawaka_cms.builder.widen'|trans }}">
                    <span class="akb-widen__expand">{{ ux_icon('tabler:layout-sidebar-right-expand') }}</span>
                    <span class="akb-widen__collapse">{{ ux_icon('tabler:layout-sidebar-right-collapse') }}</span>
                </button>
            </div>
            <div class="akb-inspector" data-akawaka-cms-builder-target="inspector" data-action="input->akawaka-cms-builder#onInspectorInput change->akawaka-cms-builder#onInspectorInput"></div>
        </div>
    </div>

    {{ form_widget(translation_form.blocks, {attr: {hidden: 'hidden', 'data-akawaka-cms-builder-target': 'input'}}) }}
</div>

    <div class="akp" hidden data-akawaka-cms-preview-target="panel">
        <div class="akp__bar">
            {% for device, icon in {mobile: 'tabler:device-mobile', tablet: 'tabler:device-tablet', desktop: 'tabler:device-desktop'} %}
                <button type="button" class="btn btn-sm" data-akawaka-cms-preview-target="device" data-device="{{ device }}" data-action="akawaka-cms-preview#selectDevice" title="{{ ('akawaka_cms.preview.' ~ device)|trans }}" aria-pressed="false">{{ ux_icon(icon) }} <span class="d-none d-md-inline">{{ ('akawaka_cms.preview.' ~ device)|trans }}</span></button>
            {% endfor %}
            <span class="akp__width text-muted small" data-akawaka-cms-preview-target="width"></span>
            <span class="badge bg-warning-lt" hidden data-akawaka-cms-preview-target="warnings"></span>
            <span class="small ms-auto" data-akawaka-cms-preview-target="status"></span>
            <button type="button" class="btn btn-sm" data-action="akawaka-cms-preview#refresh" title="{{ 'akawaka_cms.preview.refresh'|trans }}">{{ ux_icon('tabler:refresh') }}</button>
            <a class="btn btn-sm" target="_blank" rel="noopener" href="#" data-akawaka-cms-preview-target="open" title="{{ 'akawaka_cms.preview.open'|trans }}">{{ ux_icon('tabler:external-link') }}</a>
        </div>
        <div class="akp__stage" data-akawaka-cms-preview-target="stage">
            <div class="akp__scaler" data-akawaka-cms-preview-target="scaler">
                <div class="akp__viewport" data-akawaka-cms-preview-target="viewport"></div>
            </div>
        </div>
    </div>
</div>
